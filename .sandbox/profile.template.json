{
  "$schema": "/Users/mkuckert/.config/nono/nono-profile.schema.json",
  "extends": ["always-further/opencode"],
  "meta": {
    "name": "env",
    "version": "1"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [],
    "deny": ["~/.gitconfig"],
    "read_file": [
      "~/.gitconfig-private",
      "~/.gitconfig-work",
      "~/.gitconfig-agents",
      "~/.gitignore",
      "~/.bashrc"
    ],
    "read": ["~/.config/gh", "~/.CFUserTextEncoding"],
    "bypass_protection": ["~/.bashrc"]
  },
  "network": {
    "allow_domain": ["localhost"],
    "open_port_range": [[11400, 11500]]
  },
  "environment": {
    "allow_vars": [
      "HOME",
      "SHELL",
      "TERM",
      "PATH",
      "LSCOLORS",
      "LS_COLORS",
      "LC_ALL",
      "LANG",
      "PWD",
      "USER",
      "EDITOR",
      "OPENCODE_ENABLE_EXA",
      "OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS",
      "OMLX_PORT",
      "OMLX_API_KEY",
      "APFEL_PORT",
      "APFEL_TOKEN",
      "DO_NOT_TRACK"
    ],
    "set_vars": {
      "GIT_CONFIG_GLOBAL": "~/.gitconfig-agents"
    }
  }
}
