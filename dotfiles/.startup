#!/usr/bin/env bash

set -Eeuo pipefail

readonly startup_dir="${STARTUP_DIR:-${HOME}/.startup.d}"

if [[ ! -d "${startup_dir}" ]]; then
  printf 'startup: script directory does not exist: %s\n' "${startup_dir}" >&2
  exit 1
fi

shopt -s nullglob
scripts=("${startup_dir}"/*.sh)

if (( ${#scripts[@]} == 0 )); then
  printf 'startup: no scripts found in: %s\n' "${startup_dir}" >&2
  exit 1
fi

for script in "${scripts[@]}"; do
  if [[ ! -x "${script}" ]]; then
    printf 'startup: script is not executable: %s\n' "${script}" >&2
    exit 1
  fi

  "${script}"
  echo
done
