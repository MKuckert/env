#!/usr/bin/env bash

# Brew installed binaries
if [ ! -f  /etc/paths.d/homebrew ]; then
  export PATH="$(brew --prefix)/bin:$PATH"
fi

export PATH="$(brew --prefix coreutils)/libexec/gnubin:$PATH"
export PATH="$PATH:$(brew --prefix go)/libexec/bin"

# llama.cpp
export PATH="$PATH:$HOME/repos/llama.cpp/build/bin"

# cherri
export PATH="$PATH:$HOME/repos/cherri"

# tools from this repository
## backgrounded processes
export PATH="$PATH:$HOME/env/background-run"
## docker sandboxes
export PATH="$PATH:$HOME/env/docker/sandbox"

# go
export PATH="$PATH:$HOME/.go/bin"

# dotnet
export DOTNET_ROOT="$(brew --prefix dotnet)/libexec"
