#!/usr/bin/env bash
export EDITOR='vim'

# Increase Bash history size, default is 500
export HISTSIZE='32768';
export HISTFILESIZE="${HISTSIZE}";
# Omit duplicates and commands that begin with a space from history.
export HISTCONTROL='ignoreboth';

# Prefer US English and use UTF-8.
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# No macos "use zsh" warning
export BASH_SILENCE_DEPRECATION_WARNING=1

# OpenCode
## Enables the websearch tool in opencode. See https://opencode.ai/docs/tools/#websearch
export OPENCODE_ENABLE_EXA=1
## Enable background subagent tasks
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=1

# Configures homebrew
## Make brew less verbose about potential env vars
export HOMEBREW_NO_ENV_HINTS=1

## Check Homebrew’s API for new formulae or cask data
export HOMEBREW_API_AUTO_UPDATE_SECS=86400 # 24h

## Cleanup all cached files older than this many days
export HOMEBREW_CLEANUP_MAX_AGE_DAYS=30

## If set, some brew commands will cleanup all formulae when this number of days has passed
export HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS=30

## Space-separated list of casks. Homebrew will refuse to install a cask if it or any of its dependencies is on this list
export HOMEBREW_FORBIDDEN_CASKS=

## Space-separated list of formulae. Homebrew will refuse to install a formula or cask if it or any of its dependencies is on this list
export HOMEBREW_FORBIDDEN_FORMULAE=node

# Ollama, OMLX, llama.cpp and mtplx
MODELS_BASE=$(realpath ~)/ai/models
CURRENTHOST=0.0.0.0

export OLLAMA_PORT=11434
export OLLAMA_HOST="$CURRENTHOST:$OLLAMA_PORT"
export OLLAMA_MODELS=$MODELS_BASE/ollama

export APFEL_PORT=$((OLLAMA_PORT + 1))
export APFEL_HOST=$CURRENTHOST

export OMLX_PORT=$((OLLAMA_PORT + 3))
export OMLX_MODEL_DIR=$MODELS_BASE/omlx

export LLAMA_ARG_PORT=$((OLLAMA_PORT + 4))
export LLAMA_ARG_HOST=$CURRENTHOST

export MTPLX_PORT=$((OLLAMA_PORT + 5))

export MANIFEST_PORT=$((OLLAMA_PORT + 6))

# Huggingface
export HF_HOME=~/ai/huggingface
export HF_HUB_CACHE=$HF_HOME/cache
export HF_XET_HIGH_PERFORMANCE=1

# Go
export GOPATH=~/.go

# dotnet
export DOTNET_ROOT="$(brew --prefix dotnet)/libexec"

# bun
export BUN_INSTALL="$HOME/.bun"

# Docker
export DOCKER_MCP_IN_CONTAINER=1

# Claude Code (ensure to add entries nono/profiles/mk-env.json)
## make the Glob tool respect .gitignore patterns
export CLAUDE_CODE_GLOB_NO_IGNORE=false
## hide the working directory in the startup logo
export CLAUDE_CODE_HIDE_CWD=1
## how many subagents can be running in one session before the Agent tool refuses to spawn another (default: 20)
export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=5
## number of subagent layers allowed below the main conversation (default: 3)
export CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=3
## cap the number of agentic turns when no explicit limit is passed
export CLAUDE_CODE_MAX_TURNS=200
## strip Anthropic and cloud provider credentials from subprocess environments (Bash tool, hooks, MCP stdio servers)
export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1
## disable automatic compaction when approaching the context limit. The manual /compact command remains available. Use when you want explicit control over when compaction occurs
export DISABLE_AUTO_COMPACT=1
## disable the /feedback command. Also disables /bug and /share, which report through the same path
export DISABLE_FEEDBACK_COMMAND=1
## hide the /install-github-app command
export DISABLE_INSTALL_GITHUB_APP_COMMAND=1
## hide the /upgrade command
export DISABLE_UPGRADE_COMMAND=1
## turn automatically resume if the previous session ended mid-turn off
export CLAUDE_CODE_RESUME_INTERRUPTED_TURN=0
## Use Opus 4.8 for now
export ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8

# Disable some analytics and annoying prompts
export DO_NOT_TRACK=1
export HOMEBREW_NO_ANALYTICS=1
export FASTLANE_OPT_OUT_USAGE=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export NUKE_TELEMETRY_OPTOUT=1
export VCPKG_DISABLE_METRICS=1
export HF_HUB_DISABLE_TELEMETRY=1
export SBX_NO_TELEMETRY=1
export DDEV_TIP_OF_THE_DAY=0
