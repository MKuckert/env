{
  // OpenCode V2 native config (migrated from V1, see issue #113).
  // $schema URL is shared by V1/V2; the value shape below is native V2.
  "$schema": "https://opencode.ai/config.json",

  // V1 "plugin" entries removed: opencode-cost-guard and opencode-plugin-statusbar
  // were V1-API plugins and do not run in V2. They are ported as local V2 plugins
  // under .opencode/plugins/ (auto-discovered; no config entry needed).

  "default_agent": "Buddy",

  // V1 "agent" map -> "agents"; disable -> disabled
  "agents": {
    "plan": {
      "disabled": true,
    },
    "build": {
      "disabled": true,
    },
    "explore": {
      "disabled": true,
    },
    "general": {
      "disabled": true,
    },
  },

  // V1 "permission" map -> ordered "permissions" ruleset (last match wins).
  // V2's base policy is allow-all, so only the restrictions are listed here.
  "permissions": [
    // fetching a URL (matches the URL)
    { "action": "webfetch", "resource": "*", "effect": "deny" },

    // web/code search (matches the query)
    { "action": "websearch", "resource": "*", "effect": "deny" },

    // allow external-directory access to /tmp (V1: "/tmp": "allow")
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
  ],

  // V1 flat "mcp" map -> grouped "mcp.servers"; enabled: true is the default
  // (V2 uses the inverse "disabled" flag).
  "mcp": {
    "servers": {
      "web": {
        "type": "remote",
        "url": "http://localhost:12100/mcp",
      },
    },
  },
}
