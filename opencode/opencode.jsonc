{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.6-terra",
  "small_model": "apfel/apple-foundationmodel",
  "plugin": ["spotme"],
  "server": {
    "hostname": "0.0.0.0",
    "port": 4444,
  },
  // See https://opencode.ai/docs/permissions/
  "permission": {
    // Permissive by default
    "*": "ask",

    // reading a file (matches the file path)
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },

    // all file modifications (covers edit, write, patch, multiedit)
    "edit": "allow",

    // file globbing (matches the glob pattern)
    "glob": "allow",

    // content search (matches the regex pattern)
    "grep": "allow",

    // listing files in a directory (matches the directory path)
    "list": "allow",

    // running shell commands (matches parsed commands like git status --porcelain)
    "bash": {
      "*": "ask",
      "find *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "sed *": "allow",
      "rm *": "deny",
    },

    // launching subagents (matches the subagent type)
    "task": "allow",

    // loading a skill (matches the skill name)
    "skill": "allow",

    // running LSP queries (currently non-granular)
    "lsp": "allow",

    // reading/updating the todo list
    "todoread": "deny",
    "todowrite": "deny",

    // fetching a URL (matches the URL)
    "webfetch": "allow",

    // web/code search (matches the query)
    "websearch": "allow",
    "codesearch": "allow",

    // triggered when a tool touches paths outside the project working directory
    "external_directory": {
      "*": "ask",
    },

    // triggered when the same tool call repeats 3 times with identical input
    "doom_loop": "allow",
  },
  "agent": {
    "build": {
      "mode": "primary",
    },
    "plan": {
      "mode": "primary",
    },
    "general": {
      "mode": "subagent",
    },
    "explore": {
      "mode": "subagent",
    },

    // System agents
    "compaction": {
      "mode": "primary",
      "hidden": true,
    },
    "title": {
      "mode": "primary",
      "hidden": true,
      "model": "apfel/apple-foundationmodel",
    },
    "summary": {
      "mode": "primary",
      "hidden": true,
      "model": "apfel/apple-foundationmodel",
    },
  },
  "disabled_providers": ["opencode"],
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:{env:OMLX_PORT}/v1",
        "apiKey": "{env:OMLX_API_KEY}",
      },
      "models": {
        "qwen3.8-27B-oQ4e": {
          "reasoning": true,
          "limit": { "context": 262144, "output": 100000 },
        },
        "qwen3.8-27B-oQ5e": {
          "reasoning": true,
          "limit": { "context": 262144, "output": 100000 },
        },
        "Muse-Glimmer-30B": {},
        "qwen3.6-35B-A3B": {},
        "grug-27b": {},
      },
    },
    "apfel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Apfel (local)",
      "options": {
        "baseURL": "http://127.0.0.1:{env:APFEL_PORT}/v1",
        "apiKey": "{env:APFEL_TOKEN}",
      },
      "models": {
        "apple-foundationmodel": {
          "limit": { "context": 4000, "output": 1000 },
        },
      },
    },
  },
  "subagent_depth": 5,
  "shell": "bash",
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
  },
  // Disables the snapshot feature to roll back agent changes as I'm not using it anyway
  "snapshot": false,
  "experimental": {
    "quotaToast": {
      "enableToast": false,
    },
    "batch_tool": true,
    "disable_paste_summary": true,
    "mcp_timeout": 600000,
  },
}
