{
  // OpenCode V2 native config (migrated from V1, see issue #113).
  // $schema URL is shared by V1/V2; the value shapes below are native V2.
  "$schema": "https://opencode.ai/config.json",

  // Shared top-level model; the provider/model syntax is unchanged in V2.
  "model": "github-copilot/gpt-5.6-terra",

  // V1-only fields dropped:
  //   small_model      -> the built-in title agent's model (agents.title.model below)
  //   plugin ["spotme"]-> spotme is a V1-API npm plugin that does not run in V2
  //                       and has no port in this migration
  //   server {..}      -> no V2 equivalent; the server API is an intentional
  //                       breaking change (V2 service + explicit server options)
  //   lsp: true        -> V2 preserves the field but does not run LSP servers

  // V1 "permission" map -> ordered "permissions" rules (last match wins).
  // The leading catch-all is V1's own explicit "*": "ask" entry; the specific
  // grants below follow it. It also covers external_directory (V1: ask), and
  // the managed-directory grants below restore V1's output-dir whitelist.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    // V1's base policy whitelisted its own output/temp/config directories
    // (tool-output, tmp, skill/reference dirs) and force-allowed them even
    // over user config. The leading ask-all above would otherwise prompt on
    // every re-read of truncated tool output. V2 manages the same set (default
    // XDG data/config and tmpdir paths).
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/shell/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },

    // reading a file (matches the file path)
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // all file modifications (covers the edit, write, and patch tools)
    { "action": "edit", "resource": "*", "effect": "allow" },

    // file globbing (matches the glob pattern)
    { "action": "glob", "resource": "*", "effect": "allow" },

    // content search (matches the regex pattern)
    { "action": "grep", "resource": "*", "effect": "allow" },

    // running shell commands (V1: bash; matches parsed commands)
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },

    // launching subagents (V1: task; matches the agent ID)
    { "action": "subagent", "resource": "*", "effect": "allow" },

    // loading a skill (matches the skill name)
    { "action": "skill", "resource": "*", "effect": "allow" },

    // fetching a URL (matches the URL)
    { "action": "webfetch", "resource": "*", "effect": "allow" },

    // web/code search (matches the query); V1's separate "codesearch" action
    // has no V2 equivalent and is covered by websearch
    { "action": "websearch", "resource": "*", "effect": "allow" },

    // Dropped V1 actions with no V2 equivalent: list, lsp, todoread/todowrite,
    // doom_loop. V1's external_directory ask is already the V2 base policy.
  ],

  // V1 "agent" map -> "agents". The mode/hidden values already match the
  // V2 built-in defaults; kept for explicitness.
  "agents": {
    "build": { "mode": "primary" },
    "plan": { "mode": "primary" },
    "general": { "mode": "subagent" },
    "explore": { "mode": "subagent" },

    // System agents (hidden by default in V2)
    "compaction": { "mode": "primary", "hidden": true },
    "title": { "mode": "primary", "hidden": true, "model": "apfel/apple-foundationmodel" },
    "summary": { "mode": "primary", "hidden": true, "model": "apfel/apple-foundationmodel" },
  },

  // V1 disabled_providers -> provider policy (native V2 form)
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" },
    ],
    // V1 top-level subagent_depth -> experimental.subagent_depth
    "subagent_depth": 5,
    // Dropped V1-only experimental fields: quotaToast (no V2 equivalent),
    // batch_tool (explicitly unsupported in V2), disable_paste_summary
    // (V2 CLI setting: prompt.paste "full" in cli.json), mcp_timeout
    // (-> mcp.timeout below).
  },

  "shell": "bash",
  "formatter": true,
  // V1 compaction.prune has no V2 equivalent (token-budget retention); dropped.
  "compaction": {
    "auto": true,
  },
  // V1 "snapshot" -> "snapshots"; disables the snapshot feature to roll back agent changes
  "snapshots": false,

  // V1 experimental.mcp_timeout (600000) -> default MCP timeouts
  "mcp": {
    "timeout": {
      "catalog": 600000,
      "execution": 600000,
    },
  },

  // V1 "provider" map -> "providers"; npm -> package (AI SDK packages take the
  // aisdk: prefix), api/options -> settings.
  "providers": {
    "omlx": {
      "name": "oMLX (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:{env:OMLX_PORT}/v1",
        "apiKey": "{env:OMLX_API_KEY}",
      },
      "models": {
        // V1 model field "reasoning: true" has no V2 equivalent (accepted but
        // unsupported); removed.
        "qwen3.8-27B-oQ4e": {
          "limit": { "context": 150000, "output": 100000 },
        },
        "qwen3.8-27B-oQ5e": {
          "limit": { "context": 150000, "output": 100000 },
        },
        "Muse-Glimmer-30B": {},
        "qwen3.6-35B-A3B": {},
        "grug-27b": {},
      },
    },
    "apfel": {
      "name": "Apfel (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:{env:APFEL_PORT}/v1",
        "apiKey": "{env:APFEL_TOKEN}",
      },
      "models": {
        "apple-foundationmodel": {
          "limit": { "context": 4000, "output": 1000 },
        },
      },
    },
  },
}
